{
  "id": "anime-torrents",
  "name": "Anime Torrents (Nyaa)",
  "version": "2.2.0",
  "apiVersion": 11,
  "author": "LifReizei",
  "description": "Catálogo de anime con carátulas. Al reproducir, busca el torrent en Nyaa y lo abre en tu app externa.",
  "langs": ["es", "en"],
  "nsfw": false,
  "entry": "plugin.js",
  "color": "#02A9FF",
  "categories": ["anime"],
  "section": {
    "label": "Anime Torrents"
  },
  "hosts": ["graphql.anilist.co", "nyaa.si"],
  "streamHosts": "any",
  "capabilities": ["home", "search", "episodes", "resolve", "externalResolve"],
  "externalResolver": {
    "package": "com.kino.torcino"
  },
  "settings": [
    {
      "key": "main_section",
      "type": "section",
      "label": "Ajustes de Reproducción"
    },
    {
      "key": "external_app",
      "label": "App para abrir Torrents",
      "type": "select",
      "default": "com.kino.torcino",
      "options": [
        { "value": "com.kino.torcino", "label": "Torcino" },
        { "value": "mv.magnettv", "label": "Magnet Player" },
        { "value": "org.proninyaroslav.libretorrent", "label": "LibreTorrent" },
        { "value": "com.bittorrent.client", "label": "BitTorrent" }
      ]
    },
    {
      "key": "preferred_quality",
      "label": "Calidad preferida",
      "type": "select",
      "default": "1080p",
      "options": [
        { "value": "1080p", "label": "1080p (Recomendado)" },
        { "value": "720p", "label": "720p" },
        { "value": "2160p", "label": "4K (2160p)" }
      ]
    },
    {
      "key": "preferred_audio",
      "label": "Audio preferido",
      "type": "select",
      "default": "any",
      "options": [
        { "value": "any", "label": "Cualquier idioma" },
        { "value": "Dual Audio", "label": "Dual Audio (Latino/Inglés)" },
        { "value": "English", "label": "Solo Inglés" }
      ]
    },
    {
      "key": "tools_section",
      "type": "section",
      "label": "Herramientas"
    },
    {
      "key": "cache_status",
      "type": "status",
      "label": "Carátulas en memoria"
    },
    {
      "key": "clear_cache",
      "type": "action",
      "label": "Borrar caché de carátulas",
      "confirm": "¿Seguro que quieres borrar las carátulas guardadas?"
    },
    {
      "key": "test_sources",
      "type": "action",
      "label": "Probar fuentes (AniList y Nyaa)"
    },
    {
      "key": "reset_prefs",
      "type": "action",
      "label": "Restablecer preferencias",
      "confirm": "¿Volver a los valores de fábrica?"
    }
  ],
  "icon": "icon.png"
}